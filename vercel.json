{
  "version": 2,
  "buildCommand": "pnpm run build:frontend",
  "outputDirectory": "dist",
  "functions": {
    "backend/server.js": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend/server.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/backend/server.js"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
